# Local defaults. Copy to .env and replace secrets before deployment.
APP_ENV=development
DATABASE_URL=sqlite:///./solar_studio.db
SECRET_KEY=replace-with-a-random-string-at-least-32-characters-long
PUBLIC_URL=http://localhost:8000
ALLOW_PUBLIC_SIGNUP=true
INVITE_CODE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SCHEDULER_SECRET=
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MONTHLY_LIMIT_USD=5
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=1025
